# Browser-safe values (safe to expose; the anon key is public by design)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side secrets: set these as Supabase function secrets, never in the browser.
# AI_PROVIDER: "gemini" (default) or "groq"
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
